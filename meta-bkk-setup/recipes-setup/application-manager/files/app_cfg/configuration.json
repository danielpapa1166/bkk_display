{
  "apps": [
    {
      "name": "rbuflogd",
      "binary": "/usr/bin/rbuflogd",
      "args": [
        "-p", "/etc/rbuflogd",
        "-l", "0"
      ],
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"], 
      "after_exited": "", 
      "folder": "/etc/rbuflogd", 
      "environment": []
    }, 
    {
      "name": "setup_sleep", 
      "binary": "/bin/sleep",
      "args": ["1"],
      "phases": ["WIFI_CONFIG", "API_CONFIG"]
    },
    {
      "name": "wpa_helper", 
      "binary": "/usr/bin/wpa_helper",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"], 
      "after_exited": "setup_sleep", 
      "environment": []
    },
    {
      "name": "wpa_supplicant",
      "binary": "/usr/sbin/wpa_supplicant",
      "args": [
        "-i", "wlan0", 
        "-c", "/run/wpa_supplicant-ap.conf", 
        "-B"
      ], 
      "phases": ["WIFI_CONFIG"], 
      "after_exited": "wpa_helper"
    },  
    {
      "name": "web-setup-helper", 
      "binary": "/usr/bin/bkk-web-setup-helper",
      "phases": ["WIFI_CONFIG", "API_CONFIG"], 
      "environment": [
        "QT_QPA_PLATFORM=eglfs", 
        "QT_QPA_EGLFS_HIDECURSOR=1"
      ], 
      "after_exited": "wpa_supplicant"
    }, 
    { 
      "name": "web-setup-server:wifi_config",
      "binary": "/usr/bin/config-server",
      "args": [
        "--mode=wifi"
      ], 
      "phases": ["WIFI_CONFIG"], 
      "after_exited": "wpa_supplicant"
    }
  ]
}