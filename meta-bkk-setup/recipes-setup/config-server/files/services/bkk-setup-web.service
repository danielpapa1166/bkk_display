[Unit]
Description=BKK Display Setup Web Server - Phase 1 (WiFi config, AP mode)
After=bkk-boot-mode.service systemd-networkd.service
Requires=bkk-boot-mode.service
# Only run in phase 1: neither flag exists yet.
ConditionPathExists=!/etc/bkk-display-config/api-configured
ConditionPathExists=!/etc/bkk-display-config/wifi-configured

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'wpa_supplicant -i wlan0 -c /run/wpa_supplicant-ap.conf -B'
ExecStart=/usr/bin/config-server --mode=wifi
ExecStopPost=/bin/sh -c 'killall wpa_supplicant 2>/dev/null || true'
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
