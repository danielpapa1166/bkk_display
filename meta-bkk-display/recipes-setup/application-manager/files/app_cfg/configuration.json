{
  "apps": [
    {
      "name": "rbuflogd",
      "binary": "/usr/bin/rbuflogd",
      "args": [
        "-p", "/etc/rbuflogd",
        "-l", "0", 
        "--log-init-success"
      ],
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"], 
      "after_exited": "", 
      "folder": "/etc/rbuflogd", 
      "environment": []
    }, 
    {
      "name": "logger_check",
      "binary": "/usr/bin/logger_check",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "args": ["--timeout", "30"],
      "after_started": "rbuflogd"
    },
    {
      "name": "network-manager", 
      "binary": "/usr/bin/network_manager",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_exited": "logger_check"
    },
    {
      "name": "web-config-server",
      "binary": "/usr/bin/config-server",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_started": "network-manager"
    },
    {
      "name": "bkk_uds_server",
      "binary": "/usr/bin/bkk_uds_server",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_started": "network-manager"
    },
    {
      "name": "screen_owner_delay", 
      "binary": "/bin/sleep",
      "args": ["2"],
      "phases": ["NORMAL"],
      "after_started": "bkk_uds_server"
    },
    {
      "name": "bkk-screen-owner", 
      "binary": "/usr/bin/bkk-screen-owner",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "args": ["-platform", "linuxfb"],
      "after_started": "screen_owner_delay"
    },
    {
      "name": "screen-setup-time",
      "binary": "/bin/sleep",
      "args": ["2"],
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_started": "bkk-screen-owner"
    }, 
    {
      "name": "bkk-screen-info-bar",
      "binary": "/usr/bin/bkk_screen_info_bar",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_exited": "screen-setup-time"
    }, 
    {
      "name": "bkk-screen-main-content",
      "binary": "/usr/bin/bkk_screen_main_content",
      "phases": ["WIFI_CONFIG", "API_CONFIG", "NORMAL"],
      "after_exited": "screen-setup-time"
    }
  ]
}