[Unit]
Description=BKK Display Boot Mode Restore (client mode cleanup)
After=local-fs.target
Before=network-pre.target wpa_supplicant@wlan0.service
# Run on phase-2 and fully-configured boots (wifi-configured is never removed
# after it has been written once, so this covers both cases).
ConditionPathExists=/etc/bkk-display-config/wifi-configured

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bkk-setup/bkk-boot-mode-restore.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
